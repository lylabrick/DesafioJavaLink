            "url": { "raw": "{{baseUrl}}/api/accounts/balance", "host": ["{{baseUrl}}"], "path": ["api", "accounts", "balance"] }
          }
        }
      ]
    },
    {
      "name": "Extraccion",
      "item": [
        {
          "name": "Extraer 100 OK (Ana, cuenta 1)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', function () { pm.response.to.have.status(200); });",
            "pm.test('trae amount y balance', function () {",
            "  var body = pm.response.json();",
            "  pm.expect(body).to.have.property('amount');",
            "  pm.expect(body).to.have.property('balance');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"cardNumber\": \"4000111122223333\",\n  \"accountNumber\": \"0000000001\",\n  \"amount\": 100.00\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/transactions/extract", "host": ["{{baseUrl}}"], "path": ["api", "transactions", "extract"] }
